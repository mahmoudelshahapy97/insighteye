# ========================
# Project Information
# ========================
PROJECT_NAME="Insighteye API"
PROJECT_DESCRIPTION="Insighteye API with various ML capabilities"
PROJECT_VERSION="1.0.0"

# ========================
# App Settings
# ========================
APP_API_PREFIX="/api/v2"
APP_RELOAD=true
APP_DEBUG=true
APP_DESCRIPTION="Insighteye API with various ML capabilities"
APP_HOST="0.0.0.0"
APP_PORT=8000
APP_NAME="Insighteye API"
APP_VERSION="1.0.0"
APP_LOG_LEVEL="info"
APP_WORKERS=8
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# ========================
# AWS S3 Backup Configuration
# ========================
# Your AWS credentials
AWS_ACCESS_KEY_ID="AKIAU72LF3R5CF6DUMEL"
AWS_SECRET_ACCESS_KEY="GBdk8Gr+pdc1aFgdpTBuomN9icJDNJZmYdkD6qI1"
AWS_DEFAULT_REGION="eu-north-1"

# S3 bucket for backups
S3_BACKUP_BUCKET="insighteye-backups"

# Backup schedule (cron format: minute hour day month weekday)
# Examples:
#   0 2 * * *      = Daily at 2 AM
#   0 */6 * * *    = Every 6 hours
#   0 2 * * 0      = Weekly on Sunday at 2 AM
BACKUP_SCHEDULE="0 2 * * *"

# Keep backups for N days (older backups will be deleted)
BACKUP_RETENTION_DAYS=30

# ========================
# Logging
# ========================
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
LOG_LEVEL="INFO"

# ========================
# CORS & Trusted Hosts
# ========================
CORS_ORIGINS="13.61.228.251,http://13.61.228.251,http://localhost:8000,http://localhost:3000,localhost"
TRUSTED_HOSTS="127.0.0.1,localhost"

# ========================
# Qdrant Settings
# ========================
QDRANT_URL="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME="person_counts"
QDRANT_QUERY_TIMEOUT=50
QDRANT_FETCH_LIMIT=50
QDRANT_VECTOR_SIZE=1

# Elasticsearch Configuration (if using Elasticsearch)
ELASTICSEARCH_HOSTS=["http://elasticsearch:9200"]
ELASTICSEARCH_INDEX_NAME=person_counts
ELASTICSEARCH_TIMEOUT=60.0
ELASTICSEARCH_VERSION=8

# ========================
# Session ID
# ========================
SESSION_ID="2gXz1vQjW7-M6XsHwZp9D1BEXyL3oAqVfJbYK9t5U2c"

