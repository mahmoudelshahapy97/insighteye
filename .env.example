# =============================================================================
# OTP
# =============================================================================
OTP_RATE_LIMIT_SECONDS=60
OTP_EXPIRATION_SECONDS=600
OTP_EXPIRY=300
SESSION_ID="2gXz1vQjW7-M6XsHwZp9D1BEXyL3oAqVfJbYK9t5U2c"

# =============================================================================
# CORS & TRUSTED HOSTS
# =============================================================================
CORS_ORIGINS='["13.61.228.251","http://13.61.228.251","http://localhost:8000","http://localhost:3000","localhost"]'
ALLOW_ORIGINS='["13.61.228.251","http://13.61.228.251","http://localhost:8000","http://localhost:3000","localhost"]'
TRUSTED_HOSTS='["127.0.0.1","localhost"]'

CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS='["GET","POST","PUT","DELETE"]'
CORS_ALLOW_HEADERS='["Content-Type","Authorization","X-Request-ID"]'
CORS_EXPOSE_HEADERS="X-Request-ID"

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
LOG_SQL_QUERIES=false

# =============================================================================
# DATABASE (POSTGRES / PGBOUNCER)
# =============================================================================
POSTGRES_DB="insighteye_db"
POSTGRES_USER="insighteye_user"
POSTGRES_PASSWORD="insighteye*+#@"
DB_HOST="172.31.25.133"
DB_PORT=6432

DB_MIN_POOL_SIZE=10
DB_MAX_POOL_SIZE=50
DB_TIMEOUT=30.0
DB_COMMAND_TIMEOUT=60.0

DB_MAX_QUERIES=50000
DB_MAX_INACTIVE_LIFETIME=3600.0

DB_HEALTH_CHECK_INTERVAL=60
DB_MAX_RETRIES=10
DB_RETRY_DELAY_BASE=2
DB_RETRY_DELAY_MAX=30

# =============================================================================
# DATA BACKEND
# =============================================================================
DATA_BACKEND=qdrant

# =============================================================================
# QDRANT
# =============================================================================
QDRANT_HOST="172.31.25.133"
QDRANT_PORT_HTTP=6333
QDRANT_PORT_GRPC=6334
QDRANT_COLLECTION_NAME="person_counts"
QDRANT_QUERY_TIMEOUT=50
QDRANT_FETCH_LIMIT=50
QDRANT_VECTOR_SIZE=1

# =============================================================================
# ELASTICSEARCH (OPTIONAL)
# =============================================================================
ELASTICSEARCH_HOSTS='["http://172.31.25.133:9200"]'
ELASTICSEARCH_INDEX_NAME="person_counts"
ELASTICSEARCH_TIMEOUT=60.0
ELASTICSEARCH_VERSION=8

# =============================================================================
# EMAIL / SMTP
# =============================================================================
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="Insighteye@gateworx.net"
SMTP_PASSWORD="ymis milr mwoo wzrv"

SENDER_EMAIL="Insighteye@gateworx.net"
SENDER_PASSWORD="ymis milr mwoo wzrv"
OTP_SENDER_EMAIL="Insighteye@gateworx.net"

# =============================================================================
# MODELS
# =============================================================================
MODEL_CACHE_DIR="./model_cache"
MODEL_DEVICE=cuda

YOLO_CONFIG_DIR="/app/.ultralytics"
PEOPLE_MODEL_PATH="models/people.pt"
GENDER_MODEL_PATH="models/gender.pt"
FIRE_MODEL_PATH="models/fire.pt"

MAX_WORKERS=4

# =============================================================================
# CHAT / LLM
# =============================================================================
CHAT_EMBEDDINGS="mixedbread-ai/mxbai-embed-large-v1"
CHAT_FORMAT=json

CHAT_LLAMA="llama3.2:1b"
CHAT_PHI="vanilj/Phi-4:Q8_0"
CHAT_PHI4="phi4"
CHAT_COMMANDRA="command-r7b-arabic"
CHAT_QWEN="qwen2.5:14b"
CHAT_QWEN_CODER="qwen2.5-coder:7b"

CHAT_MAX_NEW_TOKENS=1024
CHAT_MAX_TOKENS=1024
CHAT_NUM_PREDICT=1024
CHAT_TEMPERATURE=0.7
CHAT_TOP_P=0.95
CHAT_TOP_K=40
CHAT_TOP_K_RETRIEVER=2

SYSTEM_PROMPT="You are a helpful assistant."
TEXT_CHAT_PROMPT="You are a helpful assistant that can answer questions about the text."

# =============================================================================
# STREAM MANAGEMENT
# =============================================================================
STREAM_CLEANUP_INTERVAL_SECONDS=60
STREAM_HEALTHCHECK_INTERVAL_SECONDS=120
STREAM_STALE_THRESHOLD_SECONDS=45
STREAM_START_STAGGER_DELAY=2.0

STREAM_MANAGEMENT_LOOP_INTERVAL=30
STREAM_BATCH_UPDATE_SIZE=50
MAX_CONCURRENT_STREAM_STARTS=10

STREAM_DB_ACTIVITY_UPDATE_INTERVAL=5.0
STREAM_STOP_TIMEOUT_SECONDS=10.0
STREAM_MANAGER_POLL_INTERVAL_SECONDS=2.0

# =============================================================================
# RTSP
# =============================================================================
RTSP_CONNECTION_TIMEOUT=30
RTSP_READ_TIMEOUT=30
RTSP_RECONNECT_ATTEMPTS=10
RTSP_TRANSPORT=tcp
RTSP_BUFFER_SIZE=1

# =============================================================================
# VIDEO / PERFORMANCE
# =============================================================================
FRAME_SKIP=300
YOLO_INPUT_SIZE=640
YOLO_CONFIDENCE=0.5
YOLO_DEVICE=cpu

ENABLE_BATCH_INFERENCE=true
BATCH_SIZE=4
BATCH_MAX_WAIT_MS=100
INFERENCE_WORKERS=2

TORCH_NUM_THREADS=4
TORCH_NUM_INTEROP_THREADS=2

# =============================================================================
# SHARED STREAMS
# =============================================================================
ENABLE_STREAM_SHARING=true
MAX_SHARED_STREAMS=50
SHARED_STREAM_BUFFER_SIZE=3
SHARED_STREAM_TIMEOUT_SECONDS=30
SHARED_STREAM_MAX_FPS=30
SHARED_STREAM_MEMORY_LIMIT_MB=100

LOG_SHARED_STREAM_STATS=true
LOG_SHARED_STREAM_STATS_INTERVAL=30

# =============================================================================
# FILE / VIDEO MANAGEMENT
# =============================================================================
VIDEO_LOOP_ENABLED=true
VIDEO_RESTART_ON_END=true
VIDEO_VALIDATION_ENABLED=true
VALIDATE_VIDEO_FILES_BEFORE_PROCESSING=true
VIDEO_FILE_VALIDATION_TIMEOUT=10.0
VIDEO_FILE_MANAGER_CLEANUP_INTERVAL=300
MAX_VIDEO_RESTART_ATTEMPTS=10
SHORT_VIDEO_OPTIMIZATION=true

# =============================================================================
# ALERTS & DETECTION
# =============================================================================
PEOPLE_DETECT_INTERVAL=2.0
GENDER_DETECT_INTERVAL=10.0
FIRE_DETECT_INTERVAL=5.0

PEOPLE_COUNT_COOLDOWN_DURATION_SECONDS=300
FIRE_COOLDOWN_SECONDS=600
ENABLE_PEOPLE_COUNT_EMAIL_ALERTS=true

# =============================================================================
# MONITORING
# =============================================================================
ENABLE_METRICS=true
HEALTH_CHECK_PATH=/health
