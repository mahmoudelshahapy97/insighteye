MAX_LOCAL_STREAMS=8

# =============================================================================
# PROJECT INFORMATION
# =============================================================================
PROJECT_NAME="Insighteye API"
PROJECT_DESCRIPTION="Insighteye API with various ML capabilities"
PROJECT_VERSION="1.0.0"
ENVIRONMENT=production

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME="Insighteye API"
APP_API_PREFIX="/api/v2"
APP_HOST="127.0.0.1"
APP_PORT=8000
APP_DEBUG=true
APP_RELOAD=true
APP_WORKERS=8
APP_LOG_LEVEL=info
FASTAPI_ROOT_PATH="/insighteye"

PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
USE_UVLOOP=true

# =============================================================================
# SECURITY / TOKENS
# =============================================================================
SECRET_KEY="e20d4027c260b6452f7607db8e7e4d02994d65a67d245665ba597e1d374cc2b4"
