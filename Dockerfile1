FROM nvidia/cuda:12.2.2-cudnn8-runtime-ubuntu22.04

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    gcc \
    g++ \
    curl \
    libgl1 \
    libglib2.0-0 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Set python3 as default
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3 1

# Upgrade pip and install uv
RUN python -m pip install --upgrade pip setuptools wheel
RUN pip install uv

# Copy requirements
COPY requirements.txt .

# Install Python dependencies using uv in system Python
RUN uv pip install --system --no-cache-dir -r requirements.txt

# Optional: force numpy version
RUN uv pip install --system --no-cache-dir numpy==1.26.4

# Optional: install PyTorch with CUDA
# RUN uv install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121

# Copy application code
COPY . .

# Expose port
EXPOSE 8000

# Run the app
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
