# ==================== GPU ACCELERATION CONFIGURATION ====================
# Set this to 'onnx' to use GPU-accelerated inference
# TensorRT requires .engine files which need to be pre-generated
# Options: pytorch, onnx, openvino, tensorrt
MODEL_BACKEND=onnx  # Use ONNX with GPU providers (TensorRT + CUDA)


# PyTorch Model Paths
PT_PEOPLE_MODEL_PATH="models/people.pt"
PT_GENDER_MODEL_PATH="models/gender.pt"
PT_FIRE_MODEL_PATH="models/fire.pt"

# ONNX Model Paths
ONNX_PEOPLE_MODEL_PATH="models/people.onnx"
ONNX_GENDER_MODEL_PATH="models/gender.onnx"
ONNX_FIRE_MODEL_PATH="models/fire.onnx"

# OpenVINO Model Paths
OPENVINO_PEOPLE_MODEL_PATH="models/people_openvino_model"
OPENVINO_GENDER_MODEL_PATH="models/gender_openvino_model"
OPENVINO_FIRE_MODEL_PATH="models/fire_openvino_model"

# TensorRT Model Paths
TENSORRT_PEOPLE_MODEL_PATH="models/people.engine"
TENSORRT_GENDER_MODEL_PATH="models/gender.engine"
TENSORRT_FIRE_MODEL_PATH="models/fire.engine"

# GPU Hardware Acceleration Settings
USE_HW_ACCEL=true
GPU_DEVICE_ID=0
GPU_MEMORY_LIMIT_MB=4096  # 4GB for Tesla T4
ENABLE_GPU_RESIZE=true
ENABLE_GPU_DECODE=false  # Keep false unless OpenCV built with CUDA decode

# GPU Performance Tuning
GPU_BATCH_SIZE=1
GPU_ASYNC_PROCESSING=true
GPU_FALLBACK_ON_ERROR=true

# Model Device Settings
MODEL_DEVICE=cuda
PEOPLE_DEVICE=cuda

# TensorRT Configuration
# Options: fp32, fp16, int8
TENSORRT_PRECISION=fp16
TENSORRT_MAX_BATCH_SIZE=8
TENSORRT_WORKSPACE_SIZE_MB=2048  # 2GB

# ==================== OPTIMIZED RTSP SETTINGS ====================
# Your existing RTSP settings are good, keeping them
MAX_LOCAL_STREAMS=100
MAX_CONCURRENT_STREAMS=100
MAX_STREAMS_PER_WORKSPACE=100

RTSP_TIMEOUT=15
RTSP_CONNECTION_TIMEOUT=60
RTSP_READ_TIMEOUT=180
RTSP_RECONNECT_ATTEMPTS=30

RTSP_GRACE_PERIOD_SECONDS=600
FILE_GRACE_PERIOD_SECONDS=120

ENABLE_CAMERA_LOAD_BALANCING=true
MAX_SIMULTANEOUS_CAMERA_STARTS=10
CAMERA_START_DELAY=5

STREAM_HEALTHCHECK_INTERVAL_SECONDS=180
STREAM_STALE_THRESHOLD_SECONDS=600
ZOMBIE_DETECTION_TIMEOUT_SECONDS=600

RTSP_TRANSPORT=tcp
RTSP_BUFFER_SIZE=1

# ==================== INFERENCE OPTIMIZATION ====================
# Confidence thresholds
PEOPLE_CONFIDENCE=0.5
GENDER_CONFIDENCE=0.4
FIRE_CONFIDENCE=0.75

# Frame processing
FRAME_SKIP=300  # Process every 300th frame (adjust based on needs)
YOLO_INPUT_SIZE=640
TARGET_FPS=15.0
MAX_FRAME_WIDTH=640

# Batch inference (disable for now - single GPU inference is faster)
ENABLE_BATCH_INFERENCE=false
BATCH_SIZE=1
INFERENCE_WORKERS=2

# CPU thread optimization (reduce since GPU is doing heavy lifting)
TORCH_NUM_THREADS=2
TORCH_NUM_INTEROP_THREADS=1
BATCH_MAX_WAIT_MS=100

# ==================== SHARED STREAM SETTINGS ====================
ENABLE_STREAM_SHARING=true
MAX_SHARED_STREAMS=50
SHARED_STREAM_BUFFER_SIZE=1  # Lower to reduce memory
SHARED_STREAM_TIMEOUT_SECONDS=600
SHARED_STREAM_MAX_FPS=30
SHARED_STREAM_MEMORY_LIMIT_MB=100

LOG_SHARED_STREAM_STATS=true
LOG_SHARED_STREAM_STATS_INTERVAL=30


