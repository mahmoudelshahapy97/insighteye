# ==================== CRITICAL RTSP FIXES ====================
# Increase these values for stable RTSP streaming

# Server capacity
MAX_LOCAL_STREAMS=100  # Increased from 10
MAX_CONCURRENT_STREAMS=100     # Global system limit
MAX_STREAMS_PER_WORKSPACE=100  # Per-workspace limit

# RTSP connection timeouts (seconds)
RTSP_TIMEOUT=15
RTSP_CONNECTION_TIMEOUT=60  # Increased from 30
RTSP_READ_TIMEOUT=180       # Increased from 30 (3 minutes)
RTSP_RECONNECT_ATTEMPTS=15  # Increased from 10

# Grace periods for health checks (seconds)
RTSP_GRACE_PERIOD_SECONDS=600  # 10 minutes for RTSP cameras
FILE_GRACE_PERIOD_SECONDS=120  # 2 minutes for file streams

# Performance Tuning
ENABLE_CAMERA_LOAD_BALANCING=true
MAX_SIMULTANEOUS_CAMERA_STARTS=10  # Start 10 at a time
CAMERA_START_DELAY=5               # Wait 5s between batches

# Stream health monitoring
STREAM_HEALTHCHECK_INTERVAL_SECONDS=180  # Check every 3 minutes instead of 2
STREAM_STALE_THRESHOLD_SECONDS=600       # Consider stream stale after 2 minutes
ZOMBIE_DETECTION_TIMEOUT_SECONDS=600       # 10 minutes for RTSP

# ==================== MODEL BACKEND CONFIGURATION ====================
# Options: pytorch, onnx, openvino, tensorrt
MODEL_BACKEND=pytorch

# PyTorch Model Paths
PT_PEOPLE_MODEL_PATH="models/people.pt"
PT_GENDER_MODEL_PATH="models/gender.pt"
PT_FIRE_MODEL_PATH="models/fire.pt"

# ONNX Model Paths
ONNX_PEOPLE_MODEL_PATH="models/people.onnx"
ONNX_GENDER_MODEL_PATH="models/gender.onnx"
ONNX_FIRE_MODEL_PATH="models/fire.onnx"

# OpenVINO Model Paths
OPENVINO_PEOPLE_MODEL_PATH="models/people_openvino_model"
OPENVINO_GENDER_MODEL_PATH="models/gender_openvino_model"
OPENVINO_FIRE_MODEL_PATH="models/fire_openvino_model"

# TensorRT Model Paths
TENSORRT_PEOPLE_MODEL_PATH="models/people.engine"
TENSORRT_GENDER_MODEL_PATH="models/gender.engine"
TENSORRT_FIRE_MODEL_PATH="models/fire.engine"

# TensorRT Configuration
# Options: fp32, fp16, int8
TENSORRT_PRECISION=fp16
TENSORRT_MAX_BATCH_SIZE=8
TENSORRT_WORKSPACE_SIZE_MB=2048  # 2GB

